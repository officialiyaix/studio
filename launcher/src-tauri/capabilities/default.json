{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Stabled main window. File access and URL opening go through Stabled's own validated commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-ask"
  ]
}
