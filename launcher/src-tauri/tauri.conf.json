{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stabled",
  "version": "1.0.0",
  "identifier": "app.stabled.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Stabled",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0e0e13",
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'none'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Stabled",
    "shortDescription": "Stabled \u2014 Minecraft Java Edition launcher",
    "longDescription": "Stabled is a performance-focused Minecraft: Java Edition launcher with isolated Saves, the Stabled in-game client and a Windows PC optimiser. Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.",
    "category": "Game",
    "copyright": "Stabled",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/clients/*": "clients/",
      "resources/backgrounds/*": "backgrounds/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {}
}
